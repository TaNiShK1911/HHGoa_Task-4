// ============================================================
// GSQL: Build NEXT edges between consecutive transactions per card
// Section 4, Step 4 of the implementation plan
//
// For each Card, orders its Transactions by ts and inserts
// Transaction -(NEXT)-> Transaction edges between consecutive pairs.
// Powers the card-testing window query (R5) without per-request sorting.
// ============================================================

USE GRAPH FraudInvestigation

// Create or replace the query that builds NEXT chains
CREATE OR REPLACE QUERY build_next_edges() FOR GRAPH FraudInvestigation {
  /*
   * For every Card vertex, gather its Transaction neighbors via
   * the MADE edge, sort them by the ts attribute, and create
   * NEXT edges between consecutive pairs.
   *
   * This is a one-time batch job, not a request-serving query.
   */

  TYPEDEF TUPLE<DATETIME ts, VERTEX<Transaction> v> TxnTuple;
  HeapAccum<TxnTuple>(100000, ts ASC) @txn_heap;
  ListAccum<VERTEX<Transaction>> @sorted_txns;

  AllCards = {Card.*};

  AllCards = SELECT c
             FROM AllCards:c -(MADE:e)-> Transaction:t
             ACCUM c.@txn_heap += TxnTuple(t.ts, t)
             POST-ACCUM
                 FOREACH tup IN c.@txn_heap DO
                     c.@sorted_txns += tup.v
                 END,
                 FOREACH i IN RANGE[1, c.@sorted_txns.size() - 1] DO
                     INSERT INTO NEXT VALUES(c.@sorted_txns.get(i-1), c.@sorted_txns.get(i))
                 END;

  PRINT "NEXT edges built successfully" AS status;
}

// Install the query
INSTALL QUERY build_next_edges

// Run it
RUN QUERY build_next_edges()
