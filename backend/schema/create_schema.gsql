  V291 DOUBLE, V292 DOUBLE, V293 DOUBLE, V294 DOUBLE, V295 DOUBLE, V296 DOUBLE, V297 DOUBLE, V298 DOUBLE, V299 DOUBLE, V300 DOUBLE,
  V301 DOUBLE, V302 DOUBLE, V303 DOUBLE, V304 DOUBLE, V305 DOUBLE, V306 DOUBLE, V307 DOUBLE, V308 DOUBLE, V309 DOUBLE, V310 DOUBLE,
  V311 DOUBLE, V312 DOUBLE, V313 DOUBLE, V314 DOUBLE, V315 DOUBLE, V316 DOUBLE, V317 DOUBLE, V318 DOUBLE, V319 DOUBLE, V320 DOUBLE,
  V321 DOUBLE, V322 DOUBLE, V323 DOUBLE, V324 DOUBLE, V325 DOUBLE, V326 DOUBLE, V327 DOUBLE, V328 DOUBLE, V329 DOUBLE, V330 DOUBLE,
  V331 DOUBLE, V332 DOUBLE, V333 DOUBLE, V334 DOUBLE, V335 DOUBLE, V336 DOUBLE, V337 DOUBLE, V338 DOUBLE, V339 DOUBLE
) WITH primary_id_as_attribute="true"

// --- DeviceProfile ---
// Compound key: DeviceInfo|id_30|id_31|id_33
CREATE VERTEX DeviceProfile (
  PRIMARY_ID device_key STRING,
  device_type STRING,     // mobile or desktop
  device_info STRING,     // e.g. SAMSUNG SM-G935F Build/NRD90M
  os STRING,              // id_30
  browser STRING,         // id_31
  screen STRING,          // id_33
  is_new_flag_seen BOOL
) WITH primary_id_as_attribute="true"

// --- EmailDomain ---
CREATE VERTEX EmailDomain (
  PRIMARY_ID domain STRING
) WITH primary_id_as_attribute="true"

// --- BillingRegion ---
CREATE VERTEX BillingRegion (
  PRIMARY_ID region_code STRING,   // addr1
  country_code STRING              // addr2
) WITH primary_id_as_attribute="true"

// --- ClosedCase ---
CREATE VERTEX ClosedCase (
  PRIMARY_ID case_id STRING,
  customer_id STRING,
  card_id STRING,
  opened_at DATETIME,
  closed_at DATETIME,
  outcome STRING,                // confirmed_fraud | cleared
  pattern STRING,
  first_fraud_txn_id STRING,
  n_txns INT,
  exposure_usd DOUBLE,
  actions_taken STRING,
  report_filed STRING,
  analyst_notes STRING,
  embedding LIST<DOUBLE>         // vector embedding of analyst_notes
) WITH primary_id_as_attribute="true"

// --- InvestigationCase (agent-written) ---
CREATE VERTEX InvestigationCase (
  PRIMARY_ID case_id STRING,
  status STRING,                  // open | closed_fraud | closed_legitimate | escalated
  verdict STRING,                 // fraud | legitimate | uncertain
  fraud_probability DOUBLE,
  pattern STRING,
  pattern_description STRING,
  exposure_usd DOUBLE,
  summary STRING,
  created_at DATETIME,
  updated_at DATETIME
) WITH primary_id_as_attribute="true"

// --- PolicyChunk (one per rule R0–R10) ---
CREATE VERTEX PolicyChunk (
  PRIMARY_ID rule_id STRING,
  text STRING,
  embedding LIST<DOUBLE>
) WITH primary_id_as_attribute="true"

// --- PatternChunk (one per known fraud pattern) ---
CREATE VERTEX PatternChunk (
  PRIMARY_ID pattern_id STRING,
  text STRING,
  embedding LIST<DOUBLE>
) WITH primary_id_as_attribute="true"

// --- RegDoc (regulatory document chunks) ---
CREATE VERTEX RegDoc (
  PRIMARY_ID doc_id STRING,
  source_url STRING,
  chunk_text STRING,
  embedding LIST<DOUBLE>
) WITH primary_id_as_attribute="true"


// ============================================================
// EDGE TYPES
// ============================================================

// Customer -> Card
CREATE DIRECTED EDGE OWNS (FROM Customer, TO Card) WITH REVERSE_EDGE="OWNED_BY"

// Card -> Transaction
CREATE DIRECTED EDGE MADE (FROM Card, TO Transaction) WITH REVERSE_EDGE="MADE_BY"

// Transaction -> Transaction (ordered by ts within a card)
CREATE DIRECTED EDGE NEXT (FROM Transaction, TO Transaction)

// Transaction -> DeviceProfile (online only, from identity.csv join)
CREATE DIRECTED EDGE FROM_DEVICE (FROM Transaction, TO DeviceProfile) WITH REVERSE_EDGE="DEVICE_USED_IN"

// Transaction -> EmailDomain
CREATE DIRECTED EDGE PURCHASER_EMAIL (FROM Transaction, TO EmailDomain) WITH REVERSE_EDGE="EMAIL_USED_IN"

// Transaction -> BillingRegion
CREATE DIRECTED EDGE BILLED_IN (FROM Transaction, TO BillingRegion) WITH REVERSE_EDGE="BILLED_FROM"

// ClosedCase -> Transaction
CREATE DIRECTED EDGE INVOLVES (FROM ClosedCase, TO Transaction) WITH REVERSE_EDGE="INVOLVED_IN"

// ClosedCase -> Card (primary card)
CREATE DIRECTED EDGE ON_CARD (FROM ClosedCase, TO Card) WITH REVERSE_EDGE="HAD_CASE"

// ClosedCase -> Card (connected cards)
CREATE DIRECTED EDGE CONNECTED_TO (FROM ClosedCase, TO Card) WITH REVERSE_EDGE="CONNECTED_CASE"

// InvestigationCase -> Transaction (flagged txn)
CREATE DIRECTED EDGE OPENED_FOR (FROM InvestigationCase, TO Transaction) WITH REVERSE_EDGE="OPENED_CASE"

// InvestigationCase -> Transaction (all affected txns)
CREATE DIRECTED EDGE AFFECTS (FROM InvestigationCase, TO Transaction) WITH REVERSE_EDGE="AFFECTED_BY"

// InvestigationCase -> Card (connected cards)
CREATE DIRECTED EDGE LINKS_CARD (FROM InvestigationCase, TO Card) WITH REVERSE_EDGE="LINKED_CASE"

// InvestigationCase -> ClosedCase (cited prior cases)
CREATE DIRECTED EDGE CITES (FROM InvestigationCase, TO ClosedCase) WITH REVERSE_EDGE="CITED_BY"

// InvestigationCase -> PolicyChunk (rule citations for auditability)
CREATE DIRECTED EDGE APPLIED_RULE (FROM InvestigationCase, TO PolicyChunk) WITH REVERSE_EDGE="APPLIED_IN"

// ============================================================
// CREATE THE GRAPH
// ============================================================
CREATE GRAPH FraudInvestigation(*)
